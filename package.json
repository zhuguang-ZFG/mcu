{
  "name": "mcu-road",
  "version": "0.1.0",
  "private": true,
  "description": "通往单片机之路：寄存器级 STM32 + ESP32-S3 深度教学",
  "license": "Apache-2.0",
  "scripts": {
    "docs:dev": "npm run docs:gen && vitepress dev docs",
    "docs:build": "npm run docs:gen && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "anim:lint": "node scripts/anim-lint.mjs",
    "anim:audit": "node scripts/anim-audit.mjs",
    "docs:gen": "node scripts/gen-progress.mjs",
    "readme:sync": "node scripts/gen-progress.mjs --readme",
    "readme:check": "node scripts/gen-progress.mjs --readme --check",
    "links:check": "node scripts/links-check.mjs",
    "nav:check": "node scripts/nav-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "a11y:check": "node scripts/a11y-check.mjs",
    "projects:check": "node scripts/project-catalog.mjs",
    "test": "node --test tests/*.test.mjs",
    "firmware:check": "node scripts/check-firmware.mjs",
    "quality": "npm run test && npm run projects:check && npm run docs:build && npm run anim:lint && npm run readme:check && npm run links:check && npm run nav:check && npm run seo:check && npm run perf:budget && npm run a11y:check",
    "test:browser": "playwright test",
    "site:measure": "node scripts/measure-site.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vitepress": "^1.6.3",
    "yaml": "^2.8.3"
  }
}
